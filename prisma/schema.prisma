generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BourbonCategory {
  BOURBON
  RYE
  TENNESSEE
  SCOTCH
  IRISH
  JAPANESE
  OTHER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LikeTargetType {
  POST
  REVIEW
  RECIPE
}

enum DietaryRestriction {
  DAIRY_FREE
  NUT_FREE
  EGG_FREE
  GLUTEN_FREE
  SULFITE_FREE
  VEGAN
  VEGETARIAN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum WhiskeyInterest {
  BOURBON
  SCOTCH
  RYE
  JAPANESE
  IRISH
  NOT_SURE
}

// ─── Auth models (required by NextAuth / @auth/prisma-adapter) ────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  // Ricked-specific fields
  hashedPassword        String?
  handle                String?   @unique
  displayName           String?
  bio                   String?
  avatarUrl             String?
  createdAt             DateTime  @default(now())
  hasSeenRickOnboarding  Boolean   @default(false)
  dateOfBirth            DateTime?
  hasPickedHandle        Boolean   @default(false)
  pendingEmail           String?
  pendingEmailRequestedAt DateTime?
  dietaryRestrictions   DietaryRestriction[]
  dietaryNotes          String?
  dietaryPreferencesSet Boolean              @default(false)
  whiskeyInterest       WhiskeyInterest?
  rickConversationsToday Int                 @default(0)
  rickLastResetAt        DateTime?
  isAdmin                Boolean             @default(false)

  accounts Account[]
  sessions Session[]

  // Ricked relations
  whiskeysCreated Whiskey[]
  reviews         Review[]
  posts           Post[]
  recipes         Recipe[]
  recipeRatings   RecipeRating[]
  likes           Like[]
  comments        Comment[]
  following       Follow[]       @relation("Follower")
  followers       Follow[]       @relation("Following")
  conversations   Conversation[]
  recipeReviews   RecipeReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Ricked content models ────────────────────────────────────────────────────

model Whiskey {
  id              String          @id @default(cuid())
  name            String
  brand           String
  category        BourbonCategory @default(BOURBON)
  distillery      String?
  mashBill        String?
  proof           Float?
  ageYears        Int?
  description     String?         @db.Text
  // Default to placeholder SVG; swap for real image URL in production
  imageUrl        String          @default("/images/bottle-placeholder.svg")
  createdByUserId String?
  createdAt       DateTime        @default(now())

  createdByUser User?    @relation(fields: [createdByUserId], references: [id])
  reviews       Review[]
  posts         Post[]   @relation("TaggedWhiskey")
  taggedRecipes Recipe[] @relation("RecipeWhiskey")

  @@index([name])
  @@index([brand])
  @@index([category])
}

model Review {
  id         String           @id @default(cuid())
  userId     String
  whiskeyId  String
  rating     Int              // 1–5
  body       String           @db.Text
  mediaUrl   String?
  status     ModerationStatus @default(APPROVED)
  // Reserved for future expert/critic review phase — do not surface in MVP UI
  isExpert   Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  whiskey Whiskey @relation(fields: [whiskeyId], references: [id], onDelete: Cascade)

  @@index([whiskeyId])
  @@index([userId])
  @@index([status, createdAt])
}

model Post {
  id               String           @id @default(cuid())
  userId           String
  body             String           @db.Text
  mediaUrl         String?
  taggedWhiskeyId  String?
  status           ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taggedWhiskey Whiskey? @relation("TaggedWhiskey", fields: [taggedWhiskeyId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

model Recipe {
  id                   String           @id @default(cuid())
  userId               String
  title                String
  description          String?          @db.Text
  ingredients          Json
  steps                Json
  mediaUrl             String?
  status               ModerationStatus @default(APPROVED)
  taggedWhiskeyId      String?
  // Phase 7: AI-generated recipes start unpublished; user sets isPublished via "I made this" flow
  isAiGenerated        Boolean          @default(false)
  isPublished          Boolean          @default(true)
  // FUTURE: remix functionality — allow users to fork and remix recipes in v1.1
  sourceConversationId String?
  createdAt            DateTime         @default(now())

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taggedWhiskey      Whiskey?      @relation("RecipeWhiskey", fields: [taggedWhiskeyId], references: [id])
  sourceConversation Conversation? @relation("ConversationRecipes", fields: [sourceConversationId], references: [id])
  ratings            RecipeRating[]
  recipeReviews      RecipeReview[]

  @@index([userId])
  @@index([taggedWhiskeyId])
  @@index([status, createdAt])
}

// Recipe reviews — star rating (required) + optional written body.
// Unique per (userId, recipeId) — one review per user per recipe; editable.
model RecipeReview {
  id        String           @id @default(cuid())
  userId    String
  recipeId  String
  rating    Int              // 1–5 stars, required
  body      String?          @db.Text
  status    ModerationStatus @default(APPROVED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId, status, createdAt])
  @@index([userId])
}

// Letterboxd-style dual rating: stars (quality) + wouldMakeAgain (preference).
// At least one must be non-null to count as a rating.
// Both are nullable so users can express either signal independently.
model RecipeRating {
  userId         String
  recipeId       String
  stars          Int?      // 1–5, nullable — how good is this recipe?
  wouldMakeAgain Boolean?  // nullable — would I make this again?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([recipeId])
}

// Polymorphic likes — targetType + targetId identify the liked entity.
// No FK to the target is stored; joins are done in application code.
model Like {
  userId     String
  targetType LikeTargetType
  targetId   String
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// Polymorphic comments — same pattern as Like.
// FUTURE: one-level reply threading (Instagram/YouTube style) is a candidate
//   for post-launch v1.1. Keep the schema flat for now — comments are children
//   of posts/reviews/recipes only, no parent comments. To add threading, add
//   an optional `parentId String? @relation(...)` self-relation on this model.
model Comment {
  id         String         @id @default(cuid())
  userId     String
  targetType LikeTargetType
  targetId   String
  body       String         @db.Text
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  recipes  Recipe[]              @relation("ConversationRecipes")

  @@index([userId, updatedAt])
}

model ConversationMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  recipeJson     Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
