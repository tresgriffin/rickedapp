# Database — create a free project at https://neon.tech and copy the connection string
# Use the "pooled" connection string from Neon dashboard for Vercel/serverless deployments
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin — generate with: openssl rand -base64 32
# Used to protect /api/admin/verify-user (manual verification for beta support)
# FUTURE: replace with proper admin auth in Phase 9
ADMIN_SECRET="your-admin-secret-here"

# Google OAuth — create credentials at https://console.developers.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# TODO (Phase 2): Facebook OAuth
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# TODO (Phase 2): Apple OAuth
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Vercel Blob — connect a Blob store in your Vercel project (Storage tab)
# Token is auto-set in Vercel deployments. For local Blob testing, paste it here.
# Without this token, uploads fall back to local disk (public/uploads/).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Anthropic API — create an API key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Rick model — defaults to claude-sonnet-4-6 if not set
# RICK_MODEL="claude-sonnet-4-6"

# Email — create an API key at https://resend.com
# In dev/sandbox mode, Resend only delivers to verified email addresses
RESEND_API_KEY="re_..."

# From address for all transactional emails
# Domain must be verified in Resend before production use (Phase 8a.4)
RICKED_EMAIL_FROM="Ricked <noreply@ricked.app>"

# Social auth — set to "true" to show Google/Facebook/Apple buttons on login
# Keep "false" (or unset) for closed beta — email/password only
# TODO Phase 8b: flip to true when Google OAuth is ready for public launch
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH="false"

# Email smoke test — run: npx tsx --env-file .env.local ./prisma/test_email.ts
# Must be on your Resend sandbox allowed-emails list
# TEST_EMAIL_TO="you@example.com"

# ─── DEMO ACCOUNTS (dev/QA only — never use in production) ───────────────────
# Rotated 2026-05-07 (Phase 8a.3). Do not commit plaintext passwords to git.
# Copy these into your actual .env.local (this file is the template).
# DEMO_TRES_EMAIL="tres@ricked.app"
# DEMO_TRES_PASSWORD="GpRtKaD5Cl95NWU5"
# DEMO_BRIAN_EMAIL="brian@ricked.app"
